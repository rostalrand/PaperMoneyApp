# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Source Code
*.swift text eol=lf diff=csharp
*.h text eol=lf
*.m text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf

# Xcode Project & Configurations
*.pbxproj -text merge=union
*.xcworkspace/contents.xcworkspacedata text eol=lf
*.xcscheme text eol=lf
*.plist text eol=lf
*.entitlements text eol=lf

# Binary Assets & Archives
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.jar binary
*.framework binary
*.car binary
*.storyboardc binary
*.nib binary
